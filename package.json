{
  "name": "motivator-vscode-extension",
  "displayName": "Motivator - Break Reminder",
  "description": "A cute VS Code extension that reminds you to take breaks and keeps you healthy while coding.",
  "version": "0.1.5",
  "author": "ssnoodles",
	"publisher": "ssnoodles",
	"license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SShnoodles/motivator-vscode-extension"
  },
  "homepage": "https://github.com/SShnoodles/motivator-vscode-extension/blob/master/README.md",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "rest",
    "reminder",
    "motivator",
    "health",
    "productivity",
    "休息",
    "提醒"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "motivator.start",
        "title": "Motivator: ▶ Start Reminder"
      },
      {
        "command": "motivator.stop",
        "title": "Motivator: ⏹ Stop Reminder"
      },
      {
        "command": "motivator.showNow",
        "title": "Motivator: 🌸 Show Now"
      },
      {
        "command": "motivator.openSettings",
        "title": "Motivator: ⚙ Open Settings"
      }
    ],
    "configuration": {
      "title": "Motivator",
      "properties": {
        "motivator.language": {
          "type": "string",
          "enum": ["auto", "zh", "en"],
          "enumDescriptions": [
            "Follow VS Code display language",
            "Chinese",
            "English"
          ],
          "default": "auto",
          "description": "Display language for Motivator UI"
        },
        "motivator.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Auto-start reminder when VS Code launches"
        },
        "motivator.scheduleType": {
          "type": "string",
          "enum": [
            "interval",
            "cron"
          ],
          "enumDescriptions": [
            "Fixed interval (minutes)",
            "Cron expression (more flexible)"
          ],
          "default": "interval",
          "description": "Reminder schedule type"
        },
        "motivator.intervalMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 1440,
          "description": "Reminder interval in minutes; only used when scheduleType is 'interval'"
        },
        "motivator.cronExpression": {
          "type": "string",
          "default": "0 * * * *",
          "description": "Cron expression; only used when scheduleType is 'cron'. Examples: every hour='0 * * * *', every 30 min='*/30 * * * *', weekdays 9-18='0 9-18 * * 1-5'"
        },
        "motivator.imageOrder": {
          "type": "string",
          "enum": [
            "random",
            "sequential"
          ],
          "enumDescriptions": [
            "Random",
            "Sequential"
          ],
          "default": "random",
          "description": "Image display order"
        },
        "motivator.imagesPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom images folder. Leave empty to use the built-in images folder. Supports .png .jpg .jpeg .gif .webp .svg"
        },
        "motivator.customMessages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Custom reminder message list. Leave empty to use built-in messages"
        },
        "motivator.breakDurationMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 5,
          "maximum": 60,
          "description": "Break countdown duration in minutes, shown in the status bar after a reminder"
        },
        "motivator.showNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification popup in the bottom-right corner"
        },
        "motivator.showWebview": {
          "type": "boolean",
          "default": true,
          "description": "Open the reminder image panel"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "npm run esbuild-base -- --sourcemap",
    "watch": "npm run esbuild-base -- --sourcemap --watch",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.26.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "node-cron": "^3.0.3"
  }
}
